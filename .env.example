# GitHub OAuth 配置
# 访问 https://github.com/settings/developers 创建 OAuth App
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Cloudflare Workers 配置
# 部署后，替换为实际的 Workers 域名
VITE_API_BASE_URL=https://your-domain.workers.dev

# GitHub 仓库配置（可选，也可在应用内设置）
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=your-blog-repo

# KV Namespace ID（从 wrangler kv:namespace create 命令获取）
SESSION_KV_ID=your-kv-namespace-id

# 分支名称（默认为 main）
GITHUB_BRANCH=main
